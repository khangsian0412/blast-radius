FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
COPY tools/requirements.lock /build/requirements.lock
RUN pip install --no-cache-dir -r /build/requirements.lock coverage==7.13.5
WORKDIR /workspace
ENV SKIP_INTEGRATION=0 PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
